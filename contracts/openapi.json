  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Criterion Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "reject",
              "edit"
            ],
            "title": "Action"
          },
          "actor": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Actor"
          },
          "note": {
            "type": "string",
            "maxLength": 3000,
            "title": "Note",
            "default": ""
          },
          "edited_suggestion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Suggestion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "criterion_id",
          "action",
          "actor"
        ],
        "title": "DecisionRequest"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Version"
          },
          "role": {
            "type": "string",
            "enum": [
              "basis",
              "target"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "Content"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "version",
          "role",
          "content"
        ],
        "title": "Document"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunRequest": {
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Pack Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "model"
            ],
            "title": "Mode",
            "default": "demo"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "default": "새 검토"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 2,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pack_id",
          "documents"
        ],
        "title": "RunRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}