{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "covered",
            "partial",
            "missing",
            "conflict",
            "needs_review"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "maxLength": 3000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "criterion_id",
        "verdict",
        "reason",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "findings"
  ],
  "title": "Findings",
  "type": "object"
}