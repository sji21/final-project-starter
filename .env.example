# Demo works without a model or API key. Load environment variables before starting.
APP_DATA_DIR=.data
# A vLLM-compatible deployment, including /v1. No URL is accepted from the browser.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Optional stage-specific served model/LoRA aliases
MODEL_EXTRACT=
MODEL_REVIEW=
MODEL_CRITIC=
MODEL_TIMEOUT_SECONDS=45

